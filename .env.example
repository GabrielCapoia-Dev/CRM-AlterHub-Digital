APP_NAME="AlterHub Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_FORCE_HTTPS=false
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Container images. Production must use registry references pinned by digest.
APP_IMAGE=alterhub/app:local
NGINX_IMAGE=alterhub/nginx:local
APP_PORT=8080
DB_FORWARD_PORT=3306

# Nginx template values. TLS should terminate at the edge/load balancer.
NGINX_SERVER_NAME=_
NGINX_CLIENT_MAX_BODY_SIZE=20m
NGINX_FASTCGI_READ_TIMEOUT=120s

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=alterhub
DB_USERNAME=alterhub
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_ALLOW_EMPTY_PASSWORD=no

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
CRM_EXPORT_CONNECTION=redis
CRM_EXPORT_QUEUE=exports
CRM_EXPORT_CHUNK_SIZE=250
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BCRYPT_ROUNDS=12
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional one-time administrator bootstrap. Leave all three values empty
# unless running EssentialSeeder during the initial deployment. Use a unique
# password of at least 16 characters, then remove the values from the runtime.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Required only for the explicitly invoked DemoSeeder. Never use in production.
DEMO_USER_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
