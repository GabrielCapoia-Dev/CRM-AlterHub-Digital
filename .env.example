################################
# APP
################################
APP_NAME="AlterHub Digital"
APP_ENV=local
APP_KEY=base64:S8XMUmCZHxUrX6fbbhVCjCmoHvBFDziaD8ov5HhEUhE=
APP_DEBUG=true

APP_PORT=8800

################################
# Configuralçao de Ambiente
################################

APP_URL=http://localhost:${APP_PORT}   # Ambiente de Desenvolvimento

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US


################################
# DOCKER NAMES & IMAGES
################################
DOCKER_IMAGE_APP=
DOCKER_CONTAINER_APP=
DOCKER_CONTAINER_CRON=
DOCKER_IMAGE_DB=mysql:8.0
DOCKER_CONTAINER_DB=
DOCKER_IMAGE_PHPMYADMIN=phpmyadmin/phpmyadmin
DOCKER_CONTAINER_PHPMYADMIN=
DOCKER_NETWORK=


################################
# DOCKER PORTS
################################
DOCKER_APP_PORT=8800
DOCKER_DB_PORT=3310
DOCKER_PHPMYADMIN_PORT=8888

################################
# GOOGLE OAUTH
################################

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=


################################
# SECURITY
################################
BCRYPT_ROUNDS=12

################################
# LOG
################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

################################
# DATABASE
################################
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3307
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

MYSQL_ROOT_PASSWORD=

################################
# CACHE / SESSION
################################
CACHE_DRIVER=file

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=true

################################
# QUEUE
################################
QUEUE_CONNECTION=database

################################
# FILESYSTEM
################################
FILESYSTEM_DISK=local

################################
# MAIL
################################
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

################################
# AWS
################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

################################
# VITE
################################
VITE_APP_NAME="${APP_NAME}"



