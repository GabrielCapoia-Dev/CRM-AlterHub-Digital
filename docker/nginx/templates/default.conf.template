upstream php_backend {
    server app:9000;
    keepalive 16;
}

server {
    listen 80 default_server;
    server_name ${NGINX_SERVER_NAME};

    root /var/www/public;
    index index.php;
    charset utf-8;
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    server_tokens off;
    sendfile on;
    tcp_nopush on;
    etag on;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    location ^~ /build/assets/ {
        try_files $uri =404;
        access_log off;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location ^~ /storage/ {
        alias /var/www/storage/app/public/;
        try_files $uri =404;
        access_log off;
        expires -1;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Livewire is generated by Laravel and must remain revalidated.
    location ~* ^/livewire(?:-[^/]+)?/livewire(?:\.min)?\.js$ {
        try_files $uri /index.php?$query_string;
        access_log off;
        expires -1;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Only Vite fingerprinted assets above are immutable. Other files revalidate.
    location ~* \.(?:css|js|mjs|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|ico)$ {
        try_files $uri =404;
        access_log off;
        expires -1;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_pass php_backend;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_read_timeout ${NGINX_FASTCGI_READ_TIMEOUT};
    }

    location ~ \.php$ {
        return 404;
    }

    location ~ /\.(?!well-known(?:/|$)) {
        deny all;
    }
}
